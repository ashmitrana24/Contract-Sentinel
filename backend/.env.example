# Database configuration
DATABASE_URL=postgresql+psycopg://clauseguard:clauseguard@localhost:5432/clauseguard

# Redis configuration
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM=cg:jobs
REDIS_CONSUMER_GROUP=cg-workers
REDIS_DEAD_STREAM=cg:jobs:dead

# Storage configuration
STORAGE_DIR=./storage

# Upload limits
MAX_UPLOAD_BYTES=26214400
MAX_PAGES=500

# Worker and reliability settings
LEASE_SECONDS=120
VISIBILITY_TIMEOUT_MS=60000
MAX_ATTEMPTS=5
BACKOFF_BASE_SECONDS=2.0
BACKOFF_CAP_SECONDS=300.0
REQUEUE_AFTER_SECONDS=120
SWEEPER_INTERVAL_SECONDS=10

# OCR detection
OCR_CHARS_PER_PAGE_THRESHOLD=20

# Module 6: Ask ClauseGuard (LLM settings)
# Providers: none | fake | anthropic | openai | ollama
LLM_PROVIDER=fake
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30.0
ASK_STREAMING_ENABLED=true
DEBUG_LOG_PROMPTS=false
